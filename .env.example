# ==============================================================================
# @keytrends/seo-mcp — Variables de entorno
# ==============================================================================

# --- Obligatorias para interactuar con Google Search Console API ---
# Propiedad objetivo en GSC (formato dominio 'sc-domain:keytrends.ai' o URL con barra 'https://keytrends.ai/')
GSC_PROPERTY=sc-domain:keytrends.ai

# Client ID de la aplicación OAuth 2.0 en Google Cloud Console
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# Client Secret de la aplicación OAuth 2.0
GOOGLE_CLIENT_SECRET=tu-client-secret

# Refresh token OAuth 2.0 generado con scope https://www.googleapis.com/auth/webmasters.readonly
GOOGLE_REFRESH_TOKEN=tu-refresh-token

# --- Opcionales de sitio y rastreo ---
# Origen público del sitio web auditado para peticiones first-party (derivado automáticamente de GSC_PROPERTY si se omite)
KEYTRENDS_SITE_URL=https://keytrends.ai/

# URL explícita del sitemap de entrada (si se omite, se autodetecta sitemap_index.xml, sitemap.xml o robots.txt)
KEYTRENDS_SITEMAP_URL=https://keytrends.ai/sitemap_index.xml

# --- Proveedor de visibilidad en IA (AEO / Generative AI) ---
# Modo del provider de IA: 'auto' (detecta si hay CSVs), 'none' (informa requisitos sin inventar datos), o 'gsc_export'
KEYTRENDS_AI_PROVIDER=auto

# Directorio con los CSVs exportados del informe de IA generativa de la UI de GSC
KEYTRENDS_AI_EXPORT_DIR=/ruta/a/exportaciones-ia

# --- Operación del servidor y límites ---
# Nivel de registro a stderr: 'silent' | 'error' | 'warn' | 'info' | 'debug' (default: info)
KEYTRENDS_LOG_LEVEL=info

# Timeout HTTP en milisegundos por petición externa (default: 20000)
KEYTRENDS_HTTP_TIMEOUT_MS=20000

# Límite máximo de URLs a inspeccionar por llamada a keytrends_get_indexation (default: 50)
KEYTRENDS_MAX_INSPECT_URLS=50
